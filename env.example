# Copy this file to .env and fill in real values.
#   cp .env.example .env
# .env is gitignored and must never be committed — this example is the only
# env file that belongs in the repo.

# PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST/DATABASE
# For Render, use the External Database URL from the dashboard (host ends in
# .render.com). Copy it verbatim — don't assemble it from separate fields.
DB_URL=postgresql://user:password@host/database

# 'development' enables SQL logging hooks, the dev WebSocket server, and full
# error stack traces. Use 'production' when deployed.
NODE_ENV=development

# Secret used to sign session cookies. Generate a strong random value:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# Port the HTTP server listens on (the dev WebSocket server uses PORT + 1).
PORT=3000
