<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> · Deadweight</title>
    <link rel="stylesheet" href="/css/main.css">
    <%- typeof renderStyles === 'function' ? renderStyles() : '' %>
    <%- typeof renderScripts === 'function' ? renderScripts() : '' %>
</head>
<body>
    <header class="site-header">
        <div class="container">
            <a href="/" class="brand">
                <span class="mark">DW</span>
                <span>Deadweight</span>
            </a>
            <nav class="site-nav" aria-label="Primary">
                <ul>
                    <li><a href="/">Home</a></li>
                    <li><a href="/how-it-works">How it works</a></li>
                    <li><a href="/about">About</a></li>
                    <li><a href="/contact">Contact</a></li>

                    <% if (isLoggedIn) { %>
                        <li><a href="/dashboard">Dashboard</a></li>
                        <li><a href="/requests">My requests</a></li>
                        <% if (typeof isEmployee !== 'undefined' && isEmployee) { %>
                            <li><a href="/requests/all">All requests</a></li>
                            <li><a href="/contact/responses">Messages</a></li>
                        <% } %>
                        <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
                            <li><a href="/register/list">Users</a></li>
                        <% } %>
                        <li><a href="/logout">Logout</a></li>
                    <% } else { %>
                        <li><a href="/login">Login</a></li>
                        <li><a href="/requests/new" class="cta">Request storage</a></li>
                    <% } %>
                </ul>
            </nav>
        </div>
    </header>
