<%- include('../partials/header') %>
<main>
    <p style="margin:0 0 0.75rem;"><a href="/requests">&larr; Back to requests</a></p>

    <div class="section-head">
        <div>
            <h1 style="margin-bottom:0.35rem;"><%= request.item_name %></h1>
            <p class="muted" style="margin:0;"><%= Number(request.requested_volume) %> ft&sup3; &middot; requested by <%= request.owner_name %></p>
        </div>
        <span class="status status-<%= request.current_status %>" style="font-size:0.85rem;"><%= request.current_status.replace(/_/g, ' ') %></span>
    </div>

    <%
        const labels = {
            requested: 'Requested',
            approved: 'Approved',
            awaiting_pickup: 'Awaiting pickup',
            in_storage: 'In storage',
            out_for_return: 'Out for return',
            returned: 'Returned'
        };
    %>
    <div class="stepper" aria-hidden="true">
        <% statuses.forEach((s, i) => { %>
            <span class="node <%= i < currentIndex ? 'done' : (i === currentIndex ? 'active' : '') %>"><% if (i < currentIndex) { %>&check;<% } %></span>
            <% if (i < statuses.length - 1) { %>
                <span class="seg <%= i < currentIndex ? 'done' : '' %>"></span>
            <% } %>
        <% }); %>
    </div>
    <div class="stepper-labels">
        <% statuses.forEach(s => { %><span><%= labels[s] %></span><% }); %>
    </div>

    <div class="detail-grid" style="margin-top:2rem;">
        <div>
            <% if (request.item_description) { %>
                <div class="panel">
                    <h2>Description</h2>
                    <p style="margin:0;"><%= request.item_description %></p>
                </div>
            <% } %>

            <div class="panel">
                <h2>Photos</h2>
                <% if (images && images.length > 0) { %>
                    <div class="gallery">
                        <% images.forEach(img => { %>
                            <figure>
                                <img src="<%= img.file_url %>" alt="<%= img.caption || img.file_name %>" loading="lazy">
                                <% if (img.caption) { %><figcaption><%= img.caption %></figcaption><% } %>
                            </figure>
                        <% }); %>
                    </div>
                <% } else { %>
                    <p class="muted" style="margin:0;">No photos have been added to this request yet.</p>
                <% } %>
            </div>

            <div class="panel">
                <h2>Status timeline</h2>
                <% if (history && history.length > 0) { %>
                    <ul class="timeline">
                        <% history.forEach(h => { %>
                            <li>
                                <div class="tl-status"><%= h.status.replace(/_/g, ' ') %></div>
                                <div class="tl-meta">
                                    <%= new Date(h.changed_at).toLocaleString('en-US', { dateStyle: 'medium', timeStyle: 'short' }) %><% if (h.changed_by_name) { %> &middot; <%= h.changed_by_name %><% } %>
                                </div>
                                <% if (h.note) { %><div class="tl-note"><%= h.note %></div><% } %>
                            </li>
                        <% }); %>
                    </ul>
                <% } else { %>
                    <p class="muted" style="margin:0;">No status changes recorded yet.</p>
                <% } %>
            </div>

            <div class="panel" id="reviews">
                <h2>Reviews</h2>
                <% if (reviews && reviews.length > 0) { %>
                    <% reviews.forEach(rv => { %>
                        <div class="review">
                            <div class="stars" aria-label="<%= rv.rating %> out of 5 stars"><% for (let i = 0; i < 5; i++) { %><%= i < rv.rating ? '\u2605' : '\u2606' %><% } %></div>
                            <% if (rv.comment) { %><p style="margin:0.3rem 0;"><%= rv.comment %></p><% } %>
                            <p class="by" style="margin:0;">&mdash; <%= rv.reviewer_name %>, <%= new Date(rv.created_at).toLocaleDateString('en-US', { dateStyle: 'medium' }) %></p>
                            <% if (typeof currentUser !== 'undefined' && currentUser && rv.user_id === currentUser.id) { %>
                                <div class="review-actions" style="margin-top:0.4rem; display:flex; gap:0.5rem;">
                                    <a class="btn btn-small" href="/requests/<%= request.id %>/reviews/<%= rv.id %>/edit">Edit</a>
                                    <form action="/requests/<%= request.id %>/reviews/<%= rv.id %>/delete" method="POST" onsubmit="return confirm('Delete this review?');" style="margin:0;">
                                        <button type="submit" class="btn btn-small btn-danger">Delete</button>
                                    </form>
                                </div>
                            <% } %>
                        </div>
                    <% }); %>
                <% } else { %>
                    <p class="muted" style="margin:0;">No reviews yet.</p>
                <% } %>

                <% if (typeof isLoggedIn !== 'undefined' && isLoggedIn) { %>
                    <div class="review-form" style="margin-top:1rem;">
                        <h3 style="margin-bottom:0.5rem;">Leave a review</h3>
                        <% if (typeof reviewErrors !== 'undefined' && reviewErrors && reviewErrors.length > 0) { %>
                            <ul class="errors" style="color:#b00020; margin:0 0 0.5rem 1rem;">
                                <% reviewErrors.forEach(e => { %><li><%= e.msg %></li><% }); %>
                            </ul>
                        <% } %>
                        <form action="/requests/<%= request.id %>/reviews" method="POST">
                            <div class="field">
                                <label for="rating">Rating</label>
                                <select id="rating" name="rating" required>
                                    <option value="" <%= (typeof reviewValues === 'undefined' || !reviewValues || !reviewValues.rating) ? 'selected' : '' %>>Select a rating&hellip;</option>
                                    <% for (let r = 5; r >= 1; r--) { %>
                                        <option value="<%= r %>" <%= (typeof reviewValues !== 'undefined' && reviewValues && String(reviewValues.rating) === String(r)) ? 'selected' : '' %>><%= r %> star<%= r === 1 ? '' : 's' %></option>
                                    <% } %>
                                </select>
                            </div>
                            <div class="field">
                                <label for="comment">Comment <span class="muted">(optional)</span></label>
                                <textarea id="comment" name="comment" rows="3" placeholder="Share your experience"><%= (typeof reviewValues !== 'undefined' && reviewValues) ? reviewValues.comment : '' %></textarea>
                            </div>
                            <button type="submit" class="btn btn-primary">Post review</button>
                        </form>
                    </div>
                <% } %>
            </div>
        </div>

        <aside>
            <div class="panel">
                <h2>Details</h2>
                <dl class="kv">
                    <dt>Status</dt><dd><span class="status status-<%= request.current_status %>"><%= request.current_status.replace(/_/g, ' ') %></span></dd>
                    <dt>Volume</dt><dd><%= Number(request.requested_volume) %> ft&sup3;</dd>
                    <dt>Pickup</dt><dd><%= request.pickup_date ? new Date(request.pickup_date).toLocaleDateString('en-US', { dateStyle: 'medium' }) : 'To be scheduled' %></dd>
                    <dt>Return</dt><dd><%= request.return_date ? new Date(request.return_date).toLocaleDateString('en-US', { dateStyle: 'medium' }) : 'To be scheduled' %></dd>
                    <dt>Owner</dt><dd><%= request.owner_name %></dd>
                    <% if (typeof isEmployee !== 'undefined' && isEmployee) { %>
                        <dt>Email</dt><dd><%= request.owner_email %></dd>
                    <% } %>
                    <dt>Created</dt><dd><%= new Date(request.created_at).toLocaleDateString('en-US', { dateStyle: 'medium' }) %></dd>
                </dl>
                <% if (request.notes) { %>
                    <p class="muted" style="margin-top:1rem;font-size:0.9rem;"><strong>Notes:</strong> <%= request.notes %></p>
                <% } %>
            </div>

            <%
                const canManage = (typeof isEmployee !== 'undefined' && isEmployee)
                    || (currentUser && currentUser.id === request.user_id);
            %>
            <% if (canManage) { %>
                <div class="panel">
                    <h2>Actions</h2>
                    <a href="/requests/<%= request.id %>/edit" class="btn btn-secondary btn-block" style="margin-bottom:0.6rem;">Edit request</a>
                    <form action="/requests/<%= request.id %>/delete" method="POST"
                          onsubmit="return confirm('Delete this request? This cannot be undone.');">
                        <button type="submit" class="btn btn-ghost btn-block" style="color:#a32d2d;">Delete request</button>
                    </form>
                </div>
            <% } %>

            <% if (typeof isEmployee !== 'undefined' && isEmployee) { %>
                <div class="panel">
                    <h2>Update status</h2>
                    <form action="/requests/<%= request.id %>/status" method="POST">
                        <div class="field">
                            <label for="status">New status</label>
                            <select id="status" name="status" required>
                                <% statuses.forEach(s => { %>
                                    <option value="<%= s %>" <%= s === request.current_status ? 'selected' : '' %>><%= labels[s] %></option>
                                <% }); %>
                            </select>
                        </div>
                        <div class="field">
                            <label for="note">Note <span class="muted">(optional)</span></label>
                            <input type="text" id="note" name="note" placeholder="Added to the timeline">
                        </div>
                        <button type="submit" class="btn btn-primary btn-block">Update status</button>
                    </form>
                </div>
            <% } %>
        </aside>
    </div>
</main>
<%- include('../partials/footer') %>
