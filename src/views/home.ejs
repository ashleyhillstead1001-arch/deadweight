<%- include('partials/header') %>
<main>
    <section class="hero">
        <h1><span class="w-heavy">Student storage,</span> <span class="w-light">handled end to end.</span></h1>
        <p>We pick up from your dorm, store your belongings safely through the summer, and bring them back when the new semester starts.</p>
        <div class="hero-actions">
            <a href="/requests/new" class="btn btn-primary">Request storage</a>
            <a href="/how-it-works" class="btn btn-secondary">How it works</a>
        </div>
    </section>

    <h2>Why students use Deadweight</h2>
    <div class="feature-grid">
        <div class="feature">
            <span class="icon brand-icon" aria-hidden="true"><img src="/images/brand/W_mark_large_handtruck.png" alt=""></span>
            <h3>Doorstep pickup</h3>
            <p>Schedule a pickup date and we collect your bins and furniture straight from your room.</p>
        </div>
        <div class="feature">
            <span class="icon brand-icon" aria-hidden="true"><img src="/images/brand/deadweight_D_large.png" alt=""></span>
            <h3>Secure storage</h3>
            <p>Your items are logged, photographed, and kept in a monitored facility all summer long.</p>
        </div>
        <div class="feature">
            <span class="icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 7l9-4 9 4-9 4-9-4z"/><path d="M3 7v10l9 4 9-4V7"/><path d="M12 11v10"/></svg>
            </span>
            <h3>Return on your schedule</h3>
            <p>Pick a return date and everything is delivered back, right when you need it for move-in.</p>
        </div>
        <div class="feature">
            <span class="icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>
            </span>
            <h3>Track every stage</h3>
            <p>Follow each request from requested to returned, with a full status timeline you can check anytime.</p>
        </div>
    </div>

    <section class="hero" style="margin-top:2.5rem;">
        <h2 style="color:#fff;">Moving out soon?</h2>
        <p>Start a storage request in a couple of minutes. No account needed to browse how it works.</p>
        <div class="hero-actions">
            <a href="/requests/new" class="btn btn-primary">Get started</a>
        </div>
    </section>
</main>
<%- include('partials/footer') %>
