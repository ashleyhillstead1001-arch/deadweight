<%- include('../partials/header') %>
<main>
    <div class="empty" style="max-width:560px;margin:2rem auto;">
        <span class="icon" aria-hidden="true">&#9888;</span>
        <h1>Something went wrong</h1>
        <p>We're having technical difficulties. Please try again in a moment.</p>
        <a href="/" class="btn btn-secondary">Back to home</a>
    </div>
    <% if (NODE_ENV === 'development' && (typeof stack !== 'undefined' && stack)) { %>
        <details open style="max-width:760px;margin:1.5rem auto;">
            <summary class="muted">Error details (development only)</summary>
            <pre style="overflow:auto;background:var(--slate-100);padding:1rem;border-radius:var(--radius);"><%= error %>

<%= stack %></pre>
        </details>
    <% } %>
</main>
<%- include('../partials/footer') %>
