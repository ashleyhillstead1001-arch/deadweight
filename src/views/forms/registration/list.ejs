<%- include('../../partials/header') %>
<main>
    <h1>Registered users</h1>
    <p class="description">All accounts on the service, newest first.</p>

    <% if (users && users.length > 0) { %>
        <div class="panel" style="padding:0.5rem 1rem;">
            <table class="table">
                <thead>
                    <tr><th>Name</th><th>Email</th><th>Role</th><th>Registered</th></tr>
                </thead>
                <tbody>
                    <% users.forEach(user => { %>
                        <tr>
                            <td><%= user.name %></td>
                            <td><%= user.email %></td>
                            <td style="text-transform:capitalize;"><%= user.role %></td>
                            <td><%= new Date(user.created_at).toLocaleDateString('en-US', { dateStyle: 'medium' }) %></td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    <% } else { %>
        <div class="empty"><p>No users registered yet.</p></div>
    <% } %>
</main>
<%- include('../../partials/footer') %>
