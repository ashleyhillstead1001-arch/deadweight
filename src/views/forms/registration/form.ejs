<%- include('../../partials/header') %>
<main>
    <h1>Create your account</h1>
    <p class="description">Sign up to request storage and track your items. All fields are required.</p>

    <form method="POST" action="/register" class="form-card">
        <div class="field">
            <label for="name">Full name</label>
            <input type="text" id="name" name="name" minlength="2" placeholder="Jordan Avery" required>
        </div>
        <div class="field-row">
            <div class="field">
                <label for="email">Email address</label>
                <input type="email" id="email" name="email" placeholder="you@example.com" required>
            </div>
            <div class="field">
                <label for="emailConfirm">Confirm email</label>
                <input type="email" id="emailConfirm" name="emailConfirm" placeholder="you@example.com" required>
            </div>
        </div>
        <div class="field">
            <label for="password">Password</label>
            <input type="password" id="password" name="password" minlength="8" pattern="(?=.*[0-9])(?=.*[!@#$%^&*]).*" placeholder="At least 8 characters" required>
            <p class="hint">Must be at least 8 characters with a number and a special character.</p>
        </div>
        <div class="field">
            <label for="passwordConfirm">Confirm password</label>
            <input type="password" id="passwordConfirm" name="passwordConfirm" placeholder="Re-enter your password" required>
        </div>
        <button type="submit" class="btn btn-primary btn-block">Create account</button>
        <p class="muted" style="text-align:center;margin:1rem 0 0;font-size:0.9rem;">Already have an account? <a href="/login">Sign in</a></p>
    </form>
</main>
<%- include('../../partials/footer') %>
